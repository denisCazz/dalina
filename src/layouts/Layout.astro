---
import '@fontsource-variable/cormorant/wght.css';
import '@fontsource-variable/cormorant/wght-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { seo, site } from '../data/site';
import { jsonLdGraph } from '../lib/jsonld';

type Crumb = { name: string; path: string };

type Props = {
  title: string;
  description: string;
  path?: string;
  jsonLd?: object[];
  breadcrumbs?: Crumb[];
  noindex?: boolean;
};

const {
  title,
  description,
  path = '/',
  jsonLd = [],
  breadcrumbs = [],
  noindex = false,
} = Astro.props;

const origin = Astro.site ?? site.url;
const canonical = noindex ? null : new URL(path, origin).href;
const ogImage = new URL('/og.png', origin).href;
const ogAlt = seo.ogImageAlt;

const breadcrumbLd =
  canonical && breadcrumbs.length > 0
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${canonical}#breadcrumb`,
        itemListElement: breadcrumbs.map((crumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: crumb.name,
          item: new URL(crumb.path, origin).href,
        })),
      }
    : null;

const graph =
  jsonLd.length > 0 || breadcrumbLd
    ? jsonLdGraph([...jsonLd, ...(breadcrumbLd ? [breadcrumbLd] : [])])
    : null;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(', ')} />
    <meta name="author" content={site.legalName} />
    <meta name="application-name" content={site.name} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="format-detection" content="telephone=yes" />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="theme-color" content="#120c09" />
    <meta name="color-scheme" content="dark" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="me" href={site.social.instagram} />
    <link rel="me" href={site.social.facebook} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:street-address" content={site.address.street} />
    <meta property="og:locality" content={site.address.city} />
    <meta property="og:region" content={site.address.regionName} />
    <meta property="og:postal-code" content={site.address.postalCode} />
    <meta property="og:country-name" content={site.address.countryName} />
    <meta property="og:email" content={site.email} />
    <meta property="og:phone_number" content={site.telephone} />
    <meta property="place:location:latitude" content={String(site.geo.lat)} />
    <meta property="place:location:longitude" content={String(site.geo.lng)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="geo.region" content="IT-CN" />
    <meta name="geo.placename" content={`${site.address.city}, ${site.address.regionName}`} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />
    {canonical && <link rel="alternate" hreflang="it" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="x-default" href={canonical} />}
    {graph && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
    <script
      is:inline
      defer
      src={site.umami.src}
      data-website-id={site.umami.websiteId}
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#contenuti">Vai ai contenuti</a>
    <slot />
  </body>
</html>
