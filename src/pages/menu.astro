---
import Layout from '../layouts/Layout.astro';
import Shell from '../components/Shell.astro';
import { menu } from '../data/menu';
import { site } from '../data/site';
import { menuJsonLd, restaurantJsonLd, webpageJsonLd, websiteJsonLd } from '../lib/jsonld';

const title = 'Menu';
const description =
  "Menu D'Alina a Sommariva del Bosco: pizze classiche e speciali, cucina e dolci. Carta statica, semplice, da aggiornare al banco.";
const jsonLd = [
  restaurantJsonLd(),
  websiteJsonLd(),
  webpageJsonLd({ path: '/menu', title, description }),
  menuJsonLd(),
];
---

<Layout
  title={title}
  description={description}
  path="/menu"
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Menu', path: '/menu' },
  ]}
>
  <Shell>
    <section class="wrap page">
      <header class="menu-hero">
        <p class="kicker">La carta</p>
        <h1>Menu</h1>
        <p class="lead muted">
          Una carta semplice. Per allergie e intolleranze, chiedi a noi.
        </p>
      </header>

      <div id="menu-root">
        <nav class="toc" aria-label="Sezioni del menu">
          {menu.map((section) => (
            <a href={`#${section.id}`}>{section.title}</a>
          ))}
        </nav>

        <div class="carta">
          {menu.map((section, index) => (
            <section class="block" id={section.id}>
              <header>
                <span class="num">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h2>{section.title}</h2>
                  {section.subtitle && <p class="muted">{section.subtitle}</p>}
                </div>
              </header>

              <ul>
                {section.items.map((item) => (
                  <li>
                    <div class="dish">
                      <h3>{item.name}</h3>
                      <span class="dots" aria-hidden="true"></span>
                      {item.price && <p class="price">{item.price}€</p>}
                    </div>
                    {item.description && <p class="desc">{item.description}</p>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>

      <p class="foot muted">
        Prenotazioni: <a href={`tel:${site.telephone}`}>{site.telephoneDisplay}</a>
        {' · '}
        <a href={site.whatsapp} rel="noopener noreferrer">WhatsApp</a>
      </p>
    </section>
  </Shell>
</Layout>

<style>
  .page {
    padding: 3.5rem 0 6rem;
  }

  .menu-hero {
    margin-bottom: 2.2rem;
  }

  h1 {
    font-size: clamp(3.4rem, 10vw, 7rem);
    margin: 0.35rem 0 0.85rem;
    line-height: 0.88;
  }

  .lead {
    max-width: 32rem;
  }

  #menu-root :global(.toc),
  .toc {
    position: sticky;
    top: calc(var(--header-h) - 1px);
    z-index: 12;
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    margin: 0 -0.25rem 1.4rem;
    padding: 0.7rem 0.25rem;
    background: color-mix(in srgb, var(--espresso) 88%, transparent);
    backdrop-filter: blur(14px);
    scrollbar-width: none;
  }

  .toc::-webkit-scrollbar {
    display: none;
  }

  .toc a {
    flex: 0 0 auto;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--cream);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .toc a:hover {
    border-color: var(--gold);
    color: var(--gold);
  }

  .carta {
    background: var(--paper);
    color: var(--ink);
    border-radius: 0.2rem;
    padding: 0.4rem 1.15rem 1.15rem;
    box-shadow: 0 24px 50px color-mix(in srgb, black 28%, transparent);
  }

  .block {
    padding: 1.6rem 0.15rem 1.7rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    scroll-margin-top: calc(var(--header-h) + 4.2rem);
  }

  .block:last-child {
    border-bottom: 0;
  }

  .block header {
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
    margin-bottom: 1.15rem;
  }

  .num {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--gold);
    letter-spacing: 0.06em;
  }

  .block h2 {
    font-size: clamp(1.7rem, 4vw, 2.35rem);
    color: var(--ink);
    letter-spacing: -0.04em;
  }

  .carta .muted {
    color: color-mix(in srgb, var(--ink) 58%, transparent);
    margin-top: 0.15rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .dish {
    display: grid;
    grid-template-columns: auto minmax(1.5rem, 1fr) auto;
    gap: 0.55rem;
    align-items: baseline;
  }

  li h3 {
    font-size: 1.12rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .dots {
    border-bottom: 1px dotted color-mix(in srgb, var(--ink) 28%, transparent);
    min-width: 1.2rem;
    transform: translateY(-0.28em);
  }

  .price {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--gold-dim);
    white-space: nowrap;
  }

  .desc {
    margin-top: 0.2rem;
    color: color-mix(in srgb, var(--ink) 58%, transparent);
    font-size: 0.92rem;
    max-width: 38rem;
  }

  .foot {
    margin-top: 1.8rem;
  }

  @media (min-width: 860px) {
    .carta {
      padding: 0.5rem 2rem 1.6rem;
    }

    ul {
      gap: 1.15rem;
    }

    li h3 {
      font-size: 1.22rem;
    }
  }
</style>
