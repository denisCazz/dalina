---
import Layout from '../layouts/Layout.astro';
import Shell from '../components/Shell.astro';
import { faqs, offerings, seo, site } from '../data/site';
import { coreGraph, faqJsonLd, webpageJsonLd } from '../lib/jsonld';

const jsonLd = [
  ...coreGraph(),
  webpageJsonLd({ path: '/', title: seo.homeTitle, description: site.description }),
  faqJsonLd(),
];
---

<Layout
  title={seo.homeTitle}
  description={site.description}
  path="/"
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Home', path: '/' }]}
>
  <Shell>
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="kicker">Sommariva del Bosco · Roero</p>
          <h1>
            <span class="line-one">Il forno,</span>
            <span class="line-two">la tavola.</span>
          </h1>
          <p class="lead">
            D'Alina è ristorante e pizzeria a Sommariva. Pizza, cucina e serate in compagnia, in Via Canale.
          </p>
          <div class="hero-actions">
            <a class="btn" href="/menu">Vedi il menu</a>
            <a class="btn btn-ghost" href="/contatti">Vieni a trovarci</a>
          </div>
        </div>
        <div class="hero-aside">
          <figure class="hero-photo">
            <img
              src="/logo-dalina.png"
              width="1024"
              height="1024"
              alt="D'Alina ristorante pizzeria a Sommariva del Bosco"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        </div>
      </div>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="track">
        {Array.from({ length: 8 }).map(() => (
          <span>Pizza · cucina · Sommariva · Roero · serate · D'Alina · ristorante · pizzeria ·</span>
        ))}
      </div>
    </div>

    <section class="section aperitivo-band" id="cucina">
      <div class="wrap">
        <p class="kicker">In tavola</p>
        <h2>Tre modi di stare qui.</h2>
        <div class="tickets">
          {offerings.map((item, index) => (
            <article class:list={['ticket', index === 0 && 'featured']}>
              <p class="when">{String(index + 1).padStart(2, '0')}</p>
              <h3>{item.title}</h3>
              <p class="time">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section wrap locale">
      <div class="locale-copy">
        <p class="kicker">Chi siamo</p>
        <h2>Nel cuore del Roero, a Sommariva.</h2>
      </div>
      <p class="muted locale-text">
        D'Alina ha aperto in Via Canale 48. Un locale accogliente per la pizza, la cucina e le serate con gli
        amici. Musica, tavoli lunghi, il forno acceso. Non è solo un ristorante: è il posto dove stare insieme.
      </p>
    </section>

    <section class="section wrap faq" id="faq" aria-labelledby="faq-title">
      <div>
        <p class="kicker">Domande</p>
        <h2 id="faq-title">Prima di venire.</h2>
      </div>
      <dl>
        {faqs.map((item) => (
          <div>
            <dt>{item.question}</dt>
            <dd>{item.answer}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="section wrap visit">
      <div>
        <p class="kicker">Vieni a trovarci</p>
        <h2>{site.address.display}</h2>
        <p class="muted">{site.hours.display}</p>
        <div class="hero-actions">
          <a class="btn" href={`tel:${site.telephone}`}>Chiama {site.telephoneDisplay}</a>
          <a class="btn btn-ghost" href="/contatti">Indicazioni</a>
        </div>
      </div>
      <div class="map-card">
        <iframe
          title={`Mappa di ${site.name}`}
          src={site.maps.embed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a href={site.maps.google} target="_blank" rel="noopener noreferrer">Apri in Google Maps</a>
      </div>
    </section>
  </Shell>
</Layout>

<style>
  .hero {
    padding: 4.5rem 0 3.5rem;
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: end;
  }

  h1 {
    font-size: clamp(3.4rem, 11vw, 7.6rem);
    margin: 0.85rem 0 1.3rem;
    font-weight: 500;
    line-height: 0.86;
  }

  .line-one {
    display: block;
    font-style: italic;
    font-weight: 400;
    color: var(--cream);
  }

  .line-two {
    display: block;
    color: var(--gold);
    font-style: italic;
    font-weight: 600;
  }

  .lead {
    max-width: 38rem;
    color: var(--cream-muted);
    font-size: 1.08rem;
    overflow-wrap: break-word;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .hero-actions .btn {
    flex: 1 1 100%;
  }

  .hero-aside {
    width: 100%;
    max-width: 100%;
  }

  .hero-photo {
    position: relative;
    margin: 0 auto;
    overflow: hidden;
    width: min(22rem, 100%);
    aspect-ratio: 1;
    padding: 0.55rem;
    border-radius: 50%;
    background: var(--cream);
    box-shadow: 0 28px 48px color-mix(in srgb, black 38%, transparent);
  }

  .hero-photo::after {
    content: '';
    position: absolute;
    inset: 0.55rem;
    pointer-events: none;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    background: #000;
  }

  .locale {
    display: grid;
    gap: 1.6rem;
    align-items: end;
  }

  .locale-text {
    max-width: 36rem;
    font-size: 1.08rem;
  }

  .marquee {
    overflow: hidden;
    max-width: 100%;
    border-block: 1px solid var(--line);
    padding: 1rem 0;
    color: var(--cream);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    letter-spacing: 0.04em;
  }

  .track {
    display: flex;
    width: max-content;
    gap: 2rem;
    animation: drift 38s linear infinite;
  }

  .section {
    padding: 5rem 0;
  }

  .aperitivo-band h2,
  .locale h2,
  .visit h2 {
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    max-width: 14ch;
  }

  .aperitivo-band {
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--cream) 5%, transparent), transparent 42%),
      var(--cocoa);
    border-block: 1px solid var(--line);
  }

  .tickets {
    display: grid;
    gap: 1.2rem;
    margin-top: 2.2rem;
  }

  .ticket {
    padding: 1.6rem 1.45rem 1.4rem;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 18px 36px color-mix(in srgb, black 22%, transparent);
  }

  .ticket.featured {
    box-shadow:
      inset 0 0 0 2px var(--italy-green),
      0 18px 36px color-mix(in srgb, black 22%, transparent);
  }

  .when {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--italy-red);
    line-height: 1.55;
  }

  .ticket h3 {
    font-size: 2.55rem;
    margin: 0.35rem 0 0.4rem;
    color: var(--ink);
  }

  .time {
    color: color-mix(in srgb, var(--ink) 62%, transparent);
  }

  .faq {
    display: grid;
    gap: 1.8rem;
    align-items: start;
  }

  .faq h2 {
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    max-width: 12ch;
    margin-bottom: 0.4rem;
  }

  .faq dl {
    margin: 1.6rem 0 0;
    display: grid;
    gap: 1rem;
  }

  .faq dl > div {
    padding: 1.2rem 1.25rem 1.15rem;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--cocoa) 70%, transparent);
  }

  .faq dt {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .faq dd {
    margin: 0;
    color: var(--cream-muted);
  }

  .visit {
    display: grid;
    gap: 2rem;
    padding-bottom: 6rem;
  }

  .map-card {
    min-height: 12rem;
    border: 1px solid var(--line);
    overflow: hidden;
    background: var(--bark);
  }

  .map-card iframe {
    display: block;
    width: 100%;
    min-height: 20rem;
    border: 0;
  }

  .map-card a {
    display: block;
    padding: 1rem 1.2rem;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  @keyframes drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (min-width: 860px) {
    .hero-aside {
      justify-self: end;
      max-width: 28rem;
    }

    .hero-actions .btn {
      flex: 0 0 auto;
    }

    .hero-grid,
    .tickets,
    .locale,
    .visit {
      grid-template-columns: 1fr 1fr;
    }

    .faq dl {
      grid-template-columns: 1fr 1fr;
    }

    .tickets {
      grid-template-columns: repeat(3, 1fr);
    }

    .locale {
      gap: 3rem;
    }
  }
</style>
